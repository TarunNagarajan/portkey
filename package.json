{
  "name": "portkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare-zk-artifacts.mjs",
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "predev": "node scripts/prepare-zk-artifacts.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/prepare-zk-artifacts.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:postgres": "tsx --test --test-concurrency=1 tests/postgres-adapter.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:built": "playwright test --config playwright.built-assets.config.ts",
    "test:e2e:platform": "npm run build && playwright test --config playwright.platform-demo.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx server/migrate.ts",
    "phone:demo": "npm run build && tsx scripts/phone-demo.ts",
    "platform:demo": "npm run build && tsx scripts/platform-demo.ts",
    "test:e2e:platform-vite": "playwright test --config playwright.platform-vite.config.ts",
    "sdk:build": "tsc -p tsconfig.sdk.json",
    "sdk:pack": "npm run sdk:build && npm pack ./sdk-package --ignore-scripts",
    "sdk:example:acceptance": "npm run build && npm run sdk:pack && npm ci --prefix examples/relying-party --ignore-scripts && tsx scripts/sdk-example-acceptance.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@hpke/core": "^1.9.0",
    "@semaphore-protocol/group": "4.14.5",
    "@semaphore-protocol/identity": "4.14.5",
    "@semaphore-protocol/proof": "4.14.5",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "ethers": "6.13.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "circom_tester": "0.0.24",
    "snarkjs": {
      "ejs": "5.0.2"
    },
    "underscore": "1.13.8",
    "ws": "8.22.0",
    "qs": "6.16.1"
  }
}
