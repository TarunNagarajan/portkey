{
  "name": "portkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "share": "node scripts/share.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test --test-concurrency=1 --test-force-exit tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx server/migrate.ts",
    "zk:build": "node circuits/build.mjs",
    "zk:issue": "tsx scripts/issuer.ts issue",
    "zk:prove": "tsx scripts/proveCredential.ts",
    "test:compat": "playwright test --config playwright.compat.config.ts",
    "test:large": "playwright test --config playwright.large.config.ts",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@hpke/core": "^1.9.0",
    "@noble/curves": "^2.0.1",
    "@zk-kit/eddsa-poseidon": "^1.1.0",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "poseidon-lite": "^0.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "snarkjs": "^0.7.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "circom2": "^0.2.23",
    "circomlib": "^2.0.5",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
