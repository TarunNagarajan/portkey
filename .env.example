PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data/portkey
NODE_ENV=development
# Set GEOCODING=false to disable place lookup (rooms then need explicit coordinates).
GEOCODING=true
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Set DATABASE_URL to use a PostgreSQL server instead of the local embedded database.
# DATABASE_URL=postgresql://localhost:5432/portkey
# Pin the credential issuer instead of the committed development issuer:
# ISSUER_PUBLIC_KEY={"ax":"...","ay":"..."}

# Production requires an explicit issuer. Enable only for a course demo:
# ALLOW_DEMO_CREDENTIALS=true

# Number of trusted reverse-proxy hops. Keep 0 unless a controlled proxy is present.
TRUST_PROXY_HOPS=0
# Protect operational backlog/storage metrics with at least 32 random characters.
# METRICS_TOKEN=...
# Import independently contributed circuit artifacts before production use:
# ZK_PTAU=/secure/ceremony/phase1.ptau
# ZK_FINAL_ZKEY=/secure/ceremony/credential-final.zkey
# ZK_CEREMONY_URL=https://institution.example/ceremony/transcript
