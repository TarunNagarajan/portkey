PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data/portkey
NODE_ENV=development
TRUST_PROXY_HOPS=0
# Production requires DATABASE_URL unless explicitly using a disposable local demo database.
# ALLOW_EMBEDDED_DATABASE=true
# Set GEOCODING=false to disable place lookup (rooms then need explicit coordinates).
GEOCODING=true
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Set DATABASE_URL to use a PostgreSQL server instead of the local embedded database.
# DATABASE_URL=postgresql://localhost:5432/portkey
